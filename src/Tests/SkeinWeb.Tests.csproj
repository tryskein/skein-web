<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SkeinWeb.Tests</RootNamespace>
    <AssemblyName>SkeinWeb.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit.net v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- xunit.v3.mtp-off: xUnit.net v3 without Microsoft Testing Platform, so
         `dotnet test` keeps running through VSTest and xunit.runner.visualstudio
         (the TRX logger, the test filter and the console summary stay as they are). -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageReference Include="NATS.Net" Version="3.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests project is Microsoft.NET.Sdk (not Microsoft.NET.Sdk.Web), so
         FrameworkReference is required to access ASP.NET Core SignalR types
         (IHubContext<T>, etc.) directly from the shared framework. The
         transitive route via SkeinWeb.csproj is unreliable and conflicts
         with the legacy Microsoft.AspNetCore.SignalR 1.x NuGet. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkeinWeb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
